{
  "expo": {
    "name": "calculint-app",
    "slug": "calculint-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/assets/images/logo-calculint.png",
    "scheme": "calculintapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./app/assets/images/logo-calculint.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./app/assets/images/logo-calculint.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./app/assets/images/logo-calculint.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./app/assets/images/logo-calculint.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
